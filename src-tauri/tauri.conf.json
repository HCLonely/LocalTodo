  "bundle": {"active":true,"useLocalToolsDir":true,"targets":["nsis"],"icon":["icons/32x32.png","icons/128x128.png","icons/icon.ico"],"windows":{"nsis":{"languages":["SimpChinese","English"],"displayLanguageSelector":false,"installMode":"currentUser"},"webviewInstallMode":{"type":"downloadBootstrapper"}}}
