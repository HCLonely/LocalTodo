{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalTodo",
  "version": "1.0.1",
  "identifier": "com.localtodo.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "拾序 · 本地任务",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 640,
        "center": true,
        "devtools": false
      },
      {
        "label": "card",
        "url": "index.html?mode=card",
        "title": "拾序 · 桌面小卡片",
        "width": 360,
        "height": 480,
        "minWidth": 300,
        "minHeight": 320,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "devtools": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:"
    }
  },
  "bundle": {
    "active": false,
    "useLocalToolsDir": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
